# Runtime environment
AIOPS_ENV=development
AIOPS_PROJECT_NAME=jscn-aiops
AIOPS_TIMEZONE=Asia/Shanghai

# Host and deployment paths
AIOPS_DEPLOY_ROOT=/opt/jscn-aiops
AIOPS_DATA_ROOT=/data/jscn-aiops
AIOPS_REPORT_DIR=/data/jscn-aiops/reports
AIOPS_BACKUP_DIR=/data/jscn-aiops/backups

# Network ports
SYSLOG_UDP_PORT=10087
SNMP_TRAP_UDP_PORT=10086
SNMP_TRAP_COMMUNITY=public
ELASTICSEARCH_HTTP_PORT=9200
KIBANA_HTTP_PORT=5601
REDIS_PORT=6379
MYSQL_PORT=13306

# Elasticsearch
ELASTIC_VERSION=7.17.27
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SYSLOG_RAW_INDEX_PREFIX=jscn-aiops-syslog-raw
ELASTICSEARCH_TRAP_RAW_INDEX_PREFIX=jscn-aiops-trap-raw
ELASTICSEARCH_SYSLOG_PARSED_INDEX_PREFIX=jscn-aiops-syslog-parsed
AIOPS_ES_DATA_DIR=/data/jscn-aiops/es
AIOPS_LOGSTASH_DATA_DIR=/data/jscn-aiops/logstash/data
ES_JAVA_OPTS=-Xms2g -Xmx2g
LOGSTASH_JAVA_OPTS=-Xms1g -Xmx1g

# Kibana
KIBANA_URL=http://localhost:5601

# MySQL
MYSQL_HOST=localhost
MYSQL_DATABASE=jscn_aiops
MYSQL_USER=aiops
MYSQL_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AIOPS_BOT_USERNAME=qq-bot
AIOPS_BOT_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379/0

# AI service
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-pro

# Internal-first LLM strategy. Put real keys only in .env/deploy env, never in code.
INTERNAL_LLM_ENABLED=false
INTERNAL_LLM_BASE_URL=http://172.25.60.72:23000/v1
INTERNAL_LLM_MODEL=deepseek-v4-pro
INTERNAL_LLM_API_KEY=
# Optional comma-separated key pool. One key is selected per request.
INTERNAL_LLM_API_KEYS=
INTERNAL_LLM_TIMEOUT=30
PUBLIC_LLM_ENABLED=true
PUBLIC_LLM_BASE_URL=https://api.deepseek.com
PUBLIC_LLM_MODEL=deepseek-v4-pro
PUBLIC_LLM_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=120
AI_REASONING_EFFORT=high
MODELROUTER_API_KEY=
BRANCH_ONEAPI_API_KEY=
MINICPM_API_KEY=
AI_MANUAL_LLM_SELECTOR=llm_usage:aiops_manual_analysis

# QQ / NapCat / OneBot adapter
QQ_ADAPTER_HTTP_PORT=18088
QQ_ADAPTER_EVENT_TOKEN=
QQ_GROUP_ALLOWLIST=
QQ_BOT_SELF_ID=
QQ_TRIGGER_PREFIX=/故障,/报修,/kb,#故障,#报修
QQ_REPLY_TIMEOUT_SECONDS=90
QQ_MAX_REPLY_CHARS=1600
QQ_MAX_QUESTION_CHARS=300
QQ_GLOBAL_CONCURRENCY=6
QQ_GROUP_CONCURRENCY=3
QQ_QUEUE_SIZE=20
QQ_USER_RATE_LIMIT=3
QQ_GROUP_RATE_LIMIT=5
QQ_RATE_WINDOW_SECONDS=60
QQ_AUDIT_LOG_PATH=/data/jscn-aiops/qq-audit/qq_adapter_audit.jsonl
QQ_AUDIT_QUESTION_CHARS=300
QQ_AUDIT_ANSWER_PREVIEW_CHARS=300
QQ_BOT_STATUS_PATH=/data/jscn-aiops/qq-audit/qq_bot_status.json
QQ_BOT_MONITOR_ENABLED=true
QQ_BOT_MONITOR_INTERVAL_SECONDS=60
QQ_BOT_OFFLINE_EMAIL_ENABLED=false
QQ_BOT_OFFLINE_EMAIL_TO=
QQ_BOT_OFFLINE_EMAIL_COOLDOWN_SECONDS=3600
NAPCAT_WEBUI_BASE=http://host.docker.internal:6099
NAPCAT_WEBUI_PUBLIC_URL=
NAPCAT_WEBUI_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
ONEBOT_API_BASE=http://host.docker.internal:3000
ONEBOT_ACCESS_TOKEN=
ONEBOT_TOKEN_IN_QUERY=false
QQ_ADAPTER_AIOPS_API_BASE=http://aiops-api:8080

# Report worker
REPORT_LOOKBACK_HOURS=24
REPORT_CRON_EXPR=0 8 * * *
REPORT_TOP_N=10
