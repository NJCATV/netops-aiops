AIOPS_PROJECT_NAME=jscn-aiops
AIOPS_INTERNAL_SHARED_SECRET=
AIOPS_BOT_SERVICE_SUBJECT=service:qq-adapter
AIOPS_TIMEZONE=Asia/Shanghai

ELASTIC_VERSION=7.17.27
ELASTICSEARCH_HTTP_PORT=9200
KIBANA_HTTP_PORT=5601
SYSLOG_UDP_PORT=10087
SNMP_TRAP_UDP_PORT=10086
SNMP_TRAP_COMMUNITY=public

AIOPS_ES_DATA_DIR=/data/jscn-aiops/es
AIOPS_LOGSTASH_DATA_DIR=/data/jscn-aiops/logstash/data
AIOPS_MYSQL_DATA_DIR=/data/jscn-aiops/mysql
ES_JAVA_OPTS=-Xms2g -Xmx2g
LOGSTASH_JAVA_OPTS=-Xms1g -Xmx1g

ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_SYSLOG_RAW_INDEX_PREFIX=jscn-aiops-syslog-raw
ELASTICSEARCH_SYSLOG_PARSED_INDEX_PREFIX=jscn-aiops-syslog-parsed
ELASTICSEARCH_TRAP_RAW_INDEX_PREFIX=jscn-aiops-trap-raw

AIOPS_PYTHON_IMAGE=python:3.11-slim
SYSLOG_PARSED_INDEX=jscn-aiops-syslog-parsed-*
TRAP_RAW_INDEX=jscn-aiops-trap-raw-*
ALARM_EVENTS_INDEX=jscn-aiops-alarm-events-*
ALARM_EVENTS_INDEX_PREFIX=jscn-aiops-alarm-events
ALARM_EVENT_WORKER_ES_URL=http://elasticsearch:9200
ALARM_EVENT_WORKER_INTERVAL_SECONDS=300
ALARM_EVENT_WORKER_LOOKBACK_MINUTES=30

MYSQL_VERSION=8.0
MYSQL_IMAGE=mysql:8.0
MYSQL_PORT=13306
MYSQL_DATABASE=jscn_aiops
MYSQL_USER=aiops
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

AI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_REQUEST_TIMEOUT_SECONDS=120
AI_REASONING_EFFORT=high
DEEPSEEK_API_KEY=
INTERNAL_LLM_ENABLED=false
INTERNAL_LLM_BASE_URL=http://172.25.60.72:23000/v1
INTERNAL_LLM_MODEL=deepseek-v4-pro
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_API_KEYS=
INTERNAL_LLM_TIMEOUT=30
PUBLIC_LLM_ENABLED=true
PUBLIC_LLM_BASE_URL=https://api.deepseek.com
PUBLIC_LLM_MODEL=deepseek-v4-pro
PUBLIC_LLM_API_KEY=
MODELROUTER_API_KEY=
BRANCH_ONEAPI_API_KEY=
MINICPM_API_KEY=
AI_MANUAL_LLM_SELECTOR=llm_usage:aiops_manual_analysis
AI_RULE_LLM_ENABLED=true

FLASK_SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false
AI_API_HTTP_PORT=8080
AIOPS_API_PYTHON_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/python:3.11-slim
AI_SCHEDULER_POLL_SECONDS=60
SCHEDULER_ELASTICSEARCH_URL=http://elasticsearch:9200
NGINX_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/nginx:alpine
AIOPS_WEB_BIND=127.0.0.1
AIOPS_WEB_HTTP_PORT=5772
