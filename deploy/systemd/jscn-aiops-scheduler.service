[Unit]
Description=JSCN AIOps Scheduler (application plane)
After=network-online.target mysql.service jscn-aiops-api.service
Wants=network-online.target

[Service]
Type=simple
User=yvesyuan
Group=yvesyuan
WorkingDirectory=/opt/jscn-aiops
EnvironmentFile=/etc/jscn-aiops/app.env
ExecStart=/opt/jscn-aiops/.venv/bin/python scripts/run_ai_scheduler.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/data/jscn-aiops

[Install]
WantedBy=multi-user.target
